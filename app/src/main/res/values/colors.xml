<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Olympic navy/gold palette - named here once, referenced from themes.xml so
         there's a single source of truth instead of hex codes scattered everywhere -->
    <color name="white">#FFFFFFFF</color>

    <!-- primary: deep navy, the main brand color -->
    <color name="olympic_navy">#FF1A2B4C</color>
    <!-- soft light navy tint, for container backgrounds like the item cards -->
    <color name="olympic_navy_container">#FFDCE3F0</color>

    <!-- secondary: gold accent, reserved for the olympicSport badge so the
         color actually means something instead of being pure decoration -->
    <color name="olympic_gold">#FFF4D35E</color>

    <!-- light neutral app background -->
    <color name="surface_neutral">#FFF5F5F2</color>
    <!-- near-black for primary text on that surface -->
    <color name="text_dark">#FF1B1B1B</color>

    <!-- standard M3 error red - deliberately NOT part of the navy/gold
         palette, error states need to stay universally recognizable -->
    <color name="error_red">#FFB3261E</color>
</resources>
