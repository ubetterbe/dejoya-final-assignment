<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.dejoyafinalassessment.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />

    </fragment>

    <!-- placeholder destination for now - DetailsFragment gets built out properly next step -->
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.dejoyafinalassessment.ui.details.DetailsFragment"
        android:label="Details"
        tools:layout="@layout/fragment_details" />

</navigation>
